{
  "name": "olympiad-mentor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/ensure-prisma-client.ts && tsx scripts/backup-db.ts --if-stale && next dev --turbopack",
    "build": "tsx scripts/ensure-prisma-client.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "tsx scripts/ensure-prisma-client.ts --force",
    "db:push": "prisma db push && tsx scripts/ensure-prisma-client.ts --force",
    "db:sync": "npm run db:push",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:seed": "tsx scripts/ensure-prisma-client.ts && tsx scripts/backup-db.ts && tsx prisma/seed.ts",
    "db:reset": "tsx scripts/backup-db.ts && prisma db push --force-reset && tsx scripts/ensure-prisma-client.ts --force && tsx prisma/seed.ts",
    "db:backfill-plan-scope": "tsx scripts/backfill-plan-scope.ts",
    "db:backfill-mentor-scope": "tsx scripts/backfill-mentor-scope.ts",
    "db:backfill-xp": "tsx scripts/backfill-xp.ts",
    "content:draft-instances": "tsx scripts/draft-task-instances.ts",
    "content:export-instances": "tsx scripts/export-instances.ts",
    "test": "tsx scripts/ensure-prisma-client.ts && vitest run",
    "typecheck": "tsx scripts/ensure-prisma-client.ts && tsc --noEmit",
    "test:watch": "vitest",
    "test:coverage": "tsx scripts/ensure-prisma-client.ts && vitest run --coverage",
    "postinstall": "tsx scripts/ensure-prisma-client.ts --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
