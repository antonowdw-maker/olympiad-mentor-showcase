# DATABASE_URL — путь к локальной SQLite (файл не коммитить)
DATABASE_URL="file:./dev.db"

# Auth.js — обязателен для сессий (сгенерируй: openssl rand -base64 32)
AUTH_SECRET="change-me-in-local-env"

# Демо-пользователь: только для локального запуска, в продакшене не использовать.
# Все темы оформления открыты сразу, доступна кнопка A (показать эталон).
SEED_TEST_USER_LOGIN=demo
SEED_TEST_USER_PASSWORD=demo-local-only
SEED_TEST_USER_NAME=Демо

# Gemini — наставник (iter 5); без ключа работает fallback на контентные подсказки
# GEMINI_API_KEY=
# Таймаут: 3.6-flash часто не укладывается в 45с на чат-промпте → fallback
# GEMINI_TIMEOUT_MS=60000
# Рекомендуемый дефолт для чата: gemini-3.5-flash. При частых 503 — lite / preview.
# GEMINI_MODEL=gemini-3.5-flash
# Запасные модели через запятую при 503/429/404 (до DeepSeek); по одной попытке каждая
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.6-flash,gemini-3.1-flash-lite
# Исходящий прокси для серверных запросов к LLM (если нужен).
# Порт проверяется при старте `npm run dev`; если он закрыт, запросы идут напрямую.
# OUTBOUND_HTTPS_PROXY=http://127.0.0.1:10809
# OUTBOUND_NO_PROXY=
# DeepSeek — второй провайдер наставника (13b, opt-in). Цепочка: Gemini → DeepSeek → без ИИ
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_MS=60000
# Мягкий лимит user-сообщений к ИИ на одну задачу (сверх — fallback)
# MENTOR_LLM_MAX_TURNS=30
